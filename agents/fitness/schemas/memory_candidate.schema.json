{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_candidate.schema.json",
  "title": "Fitness Memory Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "candidates"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "key", "value", "confidence", "evidence_count", "status", "sensitivity", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["profile", "preference", "routine", "behavior_pattern", "correction", "feedback_style"]
          },
          "key": { "type": "string" },
          "value": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "evidence_count": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["candidate", "active", "stale", "conflicted", "archived"] },
          "sensitivity": { "type": "string", "enum": ["low", "medium", "high"] },
          "created_at": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
