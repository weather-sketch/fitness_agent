{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recall_state.schema.json",
  "title": "Fitness Recall State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "enabled",
    "last_active_at",
    "last_recall_at",
    "last_recall_type",
    "recall_count_recent",
    "cooldown_until",
    "preferred_recall_style",
    "last_known_context",
    "last_risk_signal",
    "last_completed_action",
    "user_response_to_last_recall"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "enabled": { "type": "boolean" },
    "last_active_at": { "type": ["string", "null"] },
    "last_recall_at": { "type": ["string", "null"] },
    "last_recall_type": {
      "type": ["string", "null"],
      "enum": [
        "training_day_no_meal_log",
        "post_workout_no_recovery_meal",
        "lapse_recovery_followup",
        "travel_or_social_meal_reset",
        "weekly_review_available",
        "low_data_gentle_restart",
        "none",
        null
      ]
    },
    "recall_count_recent": { "type": "integer", "minimum": 0 },
    "cooldown_until": { "type": ["string", "null"] },
    "preferred_recall_style": {
      "type": "string",
      "enum": ["gentle", "direct", "minimal", "off", "unknown"]
    },
    "last_known_context": { "type": ["string", "null"] },
    "last_risk_signal": {
      "type": ["string", "null"],
      "enum": ["lapse", "travel", "alcohol", "stress", "missed_workout", "none", null]
    },
    "last_completed_action": { "type": ["string", "null"] },
    "user_response_to_last_recall": {
      "type": ["string", "null"],
      "enum": ["responded", "ignored", "dismissed", null]
    }
  }
}
